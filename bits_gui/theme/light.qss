QMainWindow, QWidget {
    background: #f7f8fa;
    color: #1f2328;
    font-size: 10pt;
}

QListView, QTableView {
    background: #ffffff;
    border: 1px solid #d0d7de;
    selection-background-color: #0969da;
}

QHeaderView::section {
    background: #eef1f4;
    color: #1f2328;
    border: 0;
    padding: 6px;
}

QPushButton {
    background: #0969da;
    color: white;
    border: 0;
    border-radius: 4px;
    padding: 6px 10px;
}
